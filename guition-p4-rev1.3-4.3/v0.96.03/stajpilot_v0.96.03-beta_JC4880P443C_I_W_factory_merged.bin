function setStatus(t){$("status").textContent=t;setTimeout(function(){if($("status").textContent===t)$("status").textContent=""},1800)}
function clearFields(){for(var i=0;i<fields.length;i++){$(fields[i]).value=""}}
function cleanFileName(v){return v.replace(/[^A-Za-z0-9]/g,"").slice(0,12)}
for(var fi=1;fi<=5;fi++){
  $("file"+fi).addEventListener("input",function(){this.value=cleanFileName(this.value)})
}
$("bank").addEventListener("change",function(){$("bankForm").submit()});
$("maxBank").addEventListener("change",function(){setStatus("maxBank SAVE í•„ìš”")});
$("songForm").addEventListener("submit",function(){$("bankHidden").value=$("bank").value});
