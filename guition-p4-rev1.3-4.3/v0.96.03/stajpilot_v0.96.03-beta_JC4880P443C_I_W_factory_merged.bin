<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>StajPilot Song Config</title>
<style>
body{margin:0;background:#050607;color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
main{max-width:820px;margin:0 auto;padding:18px}
.brand{display:flex;align-items:center;gap:18px;margin:2px 0 18px;padding-bottom:14px;border-bottom:1px solid #1d252b}
.brand img{width:168px;height:auto;display:block}
.brand-title{font-size:24px;font-weight:900;letter-spacing:.04em}
.brand-sub{margin-top:4px;color:#8fdfff;font-size:13px;font-weight:800;letter-spacing:.08em}
.row{display:grid;grid-template-columns:60px 1fr;gap:10px;align-items:center;margin:10px 0}
.slotrow{grid-template-columns:60px 30ch 12ch 18ch 12ch}
.maxrow{grid-template-columns:110px minmax(86px,130px) 92px}
.bankrow{grid-template-columns:60px minmax(86px,130px) 92px}
label{color:#aaa;font-weight:700}
select,input{width:100%;box-sizing:border-box;background:#202027;color:#fff;border:1px solid #3b3b46;border-radius:8px;padding:12px;font-size:18px}
.subinput{font-size:17px;text-align:center;padding-left:8px;padding-right:8px}
.fileinput{font-size:15px;padding-left:8px;padding-right:8px}
input:focus,select:focus{outline:2px solid #ffd60a;border-color:#ffd60a}
.buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
button{border:0;border-radius:8px;padding:14px;font-size:18px;font-weight:800;color:#fff;cursor:pointer;transition:filter .12s,transform .12s}
button:hover{filter:brightness(1.18)}
button:active{filter:brightness(.82);transform:translateY(1px)}
#save{background:#34c759}
#saveMax{background:#0a84ff;padding-left:10px;padding-right:10px}
#loadBank{background:#5e5ce6;padding-left:10px;padding-right:10px}
#clear{background:#ff3b30}
.status{min-height:24px;margin-top:14px;color:#ffd60a;font-size:15px}
@media(max-width:560px){main{padding:14px}.brand{gap:12px}.brand img{width:132px}.brand-title{font-size:20px}.row,.slotrow,.maxrow,.bankrow{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<div class="brand"><img src="/stagepilot-logo.png" alt="StajPilot"><div><div class="brand-title">StajPilot</div><div class="brand-sub">SONG CONFIG</div></div></div>
<form class="row maxrow" method="post" action="/save-meta"><label for="maxBank">maxBank</label><select id="maxBank" name="maxBank">{{MAX_OPTIONS}}</select><button id="saveMax" type="submit">SAVE</button></form>
<form class="row bankrow" id="bankForm" method="get" action="/"><label for="bank">BANK</label><select id="bank" name="bank">{{BANK_OPTIONS}}</select><button id="loadBank" type="submit">LOAD</button></form>
<form id="songForm" method="post" action="/save-bank">
<input type="hidden" id="bankHidden" name="bank" value="{{BANK_VALUE}}">
<div class="row"><label for="song">SONG</label><input id="song" name="song" value="{{SONG_VALUE}}" maxlength="30" autocomplete="off"></div>
<div class="row slotrow"><label for="slot1">slot1</label><input id="slot1" name="slot1" value="{{SLOT1_VALUE}}" maxlength="20" autocomplete="off"><input class="subinput" id="sub1" name="sub1" value="{{SUB1_VALUE}}" maxlength="7" autocomplete="off" placeholder="sub"><input class="subinput" id="sub_swipe1" name="sub_swipe1" value="{{SUB_SWIPE1_VALUE}}" maxlength="12" autocomplete="off" placeholder="sub swipe"><input class="fileinput" id="file1" name="file1" value="{{FILE1_VALUE}}" maxlength="12" autocomplete="off" placeholder="filename"></div>
<div class="row slotrow"><label for="slot2">slot2</label><input id="slot2" name="slot2" value="{{SLOT2_VALUE}}" maxlength="20" autocomplete="off"><input class="subinput" id="sub2" name="sub2" value="{{SUB2_VALUE}}" maxlength="7" autocomplete="off" placeholder="sub"><input class="subinput" id="sub_swipe2" name="sub_swipe2" value="{{SUB_SWIPE2_VALUE}}" maxlength="12" autocomplete="off" placeholder="sub swipe"><input class="fileinput" id="file2" name="file2" value="{{FILE2_VALUE}}" maxlength="12" autocomplete="off" placeholder="filename"></div>
<div class="row slotrow"><label for="slot3">slot3</label><input id="slot3" name="slot3" value="{{SLOT3_VALUE}}" maxlength="20" autocomplete="off"><input class="subinput" id="sub3" name="sub3" value="{{SUB3_VALUE}}" maxlength="7" autocomplete="off" placeholder="sub"><input class="subinput" id="sub_swipe3" name="sub_swipe3" value="{{SUB_SWIPE3_VALUE}}" maxlength="12" autocomplete="off" placeholder="sub swipe"><input class="fileinput" id="file3" name="file3" value="{{FILE3_VALUE}}" maxlength="12" autocomplete="off" placeholder="filename"></div>
<div class="row slotrow"><label for="slot4">slot4</label><input id="slot4" name="slot4" value="{{SLOT4_VALUE}}" maxlength="20" autocomplete="off"><input class="subinput" id="sub4" name="sub4" value="{{SUB4_VALUE}}" maxlength="7" autocomplete="off" placeholder="sub"><input class="subinput" id="sub_swipe4" name="sub_swipe4" value="{{SUB_SWIPE4_VALUE}}" maxlength="12" autocomplete="off" placeholder="sub swipe"><input class="fileinput" id="file4" name="file4" value="{{FILE4_VALUE}}" maxlength="12" autocomplete="off" placeholder="filename"></div>
<div class="row slotrow"><label for="slot5">slot5</label><input id="slot5" name="slot5" value="{{SLOT5_VALUE}}" maxlength="20" autocomplete="off"><input class="subinput" id="sub5" name="sub5" value="{{SUB5_VALUE}}" maxlength="7" autocomplete="off" placeholder="sub"><input class="subinput" id="sub_swipe5" name="sub_swipe5" value="{{SUB_SWIPE5_VALUE}}" maxlength="12" autocomplete="off" placeholder="sub swipe"><input class="fileinput" id="file5" name="file5" value="{{FILE5_VALUE}}" maxlength="12" autocomplete="off" placeholder="filename"></div>
<div class="buttons"><button id="save" type="submit">SAVE</button><button id="clear" type="submit" formmethod="get" formaction="/" name="clear" value="1">CLEAR</button></div>
</form>
<div class="status" id="status"></div>
</main>
<script>
function $(id){return document.getElementById(id)}
var fields=["song","slot1","slot2","slot3","slot4","slot5","sub1","sub2","sub3","sub4","sub5","sub_swipe1","sub_swipe2","sub_swipe3","sub_swipe4","sub_swipe5","file1","file2","file3","file4","file5"];
var maxBank=Number($("maxBank").value)||125;
function setStatus(t);
function clearFields();
function cleanFileName(v);
static void disable_wireless_radios();
static void display_blank_for_flash();
static void display_restore_after_flash();
static char hex_digit(uint8_t v);
static int hex_value(char c);
static String storage_encode(const String& in);
static String storage_decode(const String& in);
static String json_escape(const String& in);
static String html_attr_escape(const String& in);
static String song_bank_path(int bank);
static String limit_utf8_chars(const String& in, int max_chars);
static String sanitize_file_name(const String& in);
static void copy_utf8_to_buffer(char* dst, size_t dst_len, const String& value);
static bool song_config_cache_take(uint32_t timeout_ms);
static void song_config_cache_give();
static int load_max_bank_from_legacy_txt();
static size_t song_config_dat_data_bytes();
static SongConfigDatHeader song_config_dat_make_header(int max_bank);
static bool song_config_dat_header_valid(const SongConfigDatHeader& header);
static bool song_config_cache_alloc();
static void song_config_cache_store_bank_unlocked(int bank, const String& song, const String slots[5],
                                                  const String subs[5], const String file_names[5]);
static void song_config_record_from_values(SongBankRuntimeCache& record, const String& song, const String slots[5],
                                           const String subs[5], const String file_names[5]);
static bool song_config_dat_write_all(int max_bank);
static bool song_config_dat_read_into_psram();
static void song_config_cache_fill_from_legacy_txt(int max_bank);
static bool song_config_cache_load_all_to_psram();
static int load_max_bank();
static bool song_config_dat_write_header(int max_bank);
static void save_max_bank(int max_bank);
static bool song_config_dat_write_bank_record(int bank, const SongBankRuntimeCache& record);
static bool song_swipe_cache_take(uint32_t timeout_ms);
static void song_swipe_cache_give();
static size_t song_swipe_dat_data_bytes();
static SongSwipeDatHeader song_swipe_dat_make_header();
static bool song_swipe_dat_header_valid(const SongSwipeDatHeader& header);
static bool song_swipe_cache_alloc();
static bool song_swipe_dat_write_all();
static bool song_swipe_dat_write_bank_record(int bank, const SongSwipeRuntimeCache& record);
static void song_swipe_dat_read_into_psram();
static bool song_swipe_cache_load_all_to_psram();
static bool song_swipe_cache_read_bank(int bank, String subs_swipe[5]);
static bool save_song_bank_swipe(int bank, const String subs_swipe[5]);
bool hardware_load_song_box(int bank, int rig, char* song, size_t song_len, char* slot, size_t slot_len);
bool hardware_load_song_slot_sub(int bank, int rig, char* sub, size_t sub_len);
bool hardware_load_song_bank_subs(int bank, char* out_subs, size_t slot_count, size_t sub_len);
bool hardware_load_song_bank_subs_swipe(int bank, char* out_subs_swipe, size_t slot_count, size_t sub_len);
bool hardware_load_song_slot_file(int bank, int rig, char* file_name, size_t file_name_len);
uint32_t hardware_get_song_config_revision();
static void send_no_cache();
static String make_bank_options(int count, int selected);
static void handle_config_root();
static void handle_config_logo();
static void redirect_to_bank(int bank);
static void handle_config_meta_get();
static void handle_config_meta_post();
static void handle_config_meta_form_post();
static void handle_config_bank_get();
static void handle_config_bank_post();
static void handle_config_bank_form_post();
static void setup_config_routes();
static bool config_server_take(uint32_t timeout_ms);
static void config_server_give();
static void reset_c6_wifi_slave_for_ap_start();
static void sanitize_config_wifi_password(const char* in, char* out, size_t out_len);
void hardware_get_config_wifi_password(char* pass, size_t pass_len);
void hardware_save_config_wifi_password(const char* pass);
static void config_server_task(void* arg);
void hardware_set_config_wifi(bool enabled);
static void config_wifi_worker_task(void* arg);
static void request_config_wifi_async(bool enabled);
bool hardware_is_config_wifi_enabled();
static void config_wifi_update();
void hardware_set_brightness(int val);
void hardware_save_brightness(int val);
void hardware_save_midi_channel(int ch);
void hardware_save_tuner_mode(int mode);
void hardware_save_tuner_precision_mode(bool enabled);
void hardware_save_fixed_fx_mode(int mode);
void hardware_save_box_mode(int mode);
void hardware_save_morph_poll_mode(int mode);
void hardware_save_amp_art_enabled(bool enabled);
void hardware_save_slot_sub_enabled(bool enabled);
void hardware_save_fx_icon_anim_enabled(bool enabled);
void hardware_save_swipe_nav_enabled(bool enabled);
void hardware_save_usb_mode(int mode);
static void bluetooth_set_status(const char* status);
static bool bluetooth_is_connected_address_locked(const char* address);
static int bluetooth_connected_count_locked();
static void bluetooth_clear_midi_monitor_if_idle();
static int bluetooth_find_connection_slot_by_address_locked(const char* address);
static int bluetooth_find_free_connection_slot_locked();
static void bluetooth_load_saved_devices();
static void bluetooth_save_saved_devices();
static int bluetooth_find_saved_by_address(const char* address);
static void bluetooth_add_saved_device(const KdcBluetoothDeviceInfo& device);
static void bluetooth_midi_notify_cb(BLERemoteCharacteristic* characteristic,
                                     uint8_t* data,
                                     size_t length,
                                     bool is_notify);
static void bluetooth_clear_devices_locked();
static void bluetooth_mark_connections_locked();
static void bluetooth_connect_task(void* arg);
static bool bluetooth_start_connect(const KdcBluetoothDeviceInfo& target);
static void bluetooth_scan_task(void* arg);
void hardware_set_bluetooth_enabled(bool enabled);
